<?xml version="1.0" encoding="utf-8"?>
<!-- Rendered by the system inside Samsung's Live Notification and Now Bar.
     No textColor, so it inherits whatever the surrounding notification uses.
     If it comes out unreadable on one theme, set it explicitly and check both
     the light and dark lock screen. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowbar_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="16sp"
    android:textStyle="bold" />
