<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#FF1F6F5C</color>
    <color name="paper">#FFE9EDEC</color>
    <!-- Live Update progress bar: focus reuses ink, break gets its own color
         so the two are distinguishable at a glance in the notification. -->
    <color name="progress_break">#FF2F6F9A</color>
    <!-- The already-elapsed segment's track. paper (near-white) read as a
         stark, disconnected nub against a dark notification shade; a muted
         gray blends at the seam in both light and dark shades. -->
    <color name="progress_track">#FF9098A0</color>
</resources>
